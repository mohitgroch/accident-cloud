[Unit]
Description=AI-Assisted Smart Vehicle Accident Detection Cloud Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cloud-ai-deployment
EnvironmentFile=/home/ubuntu/cloud-ai-deployment/.env
ExecStart=/home/ubuntu/cloud-ai-deployment/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/cloud-ai-deployment/logs/systemd_out.log
StandardError=append:/home/ubuntu/cloud-ai-deployment/logs/systemd_err.log

[Install]
WantedBy=multi-user.target

